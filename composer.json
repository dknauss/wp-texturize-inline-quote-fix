{
    "name": "dknauss/wp-texturize-inline-quote-fix",
    "description": "Feature plugin for locale-aware WordPress inline quote context.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {"php": ">=7.4"},
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.2",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "config": {
        "platform": {"php": "7.4.33"},
        "allow-plugins": {"dealerdirect/phpcodesniffer-composer-installer": true}
    },
    "scripts": {
        "lint": "phpcs",
        "lint:compat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 7.4- includes wp-texturize-inline-quote-fix.php wp-texturize-inline-quote-fix-faithful.php"
    }
}
